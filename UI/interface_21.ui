  <property name="styleSheet">
   <string notr="true">/* ========== GroupBox：左上→右下 浅灰→白→浅灰 渐变（加深版） ========== */
QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #dee2e6,    
                                stop:0.5 #ffffff,  
                                stop:1 #dee2e6);   
    border: 1px solid #d0d7e3;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 10px;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px;
    color: #2c3e50;
    background-color: transparent;
}

/* ========== 全局 QSpinBox 样式 ========== */
QSpinBox {
    min-width: 31px;
    max-width: 31px;
    height: 28px;
    border: 2px solid rgb(208, 208, 208);
    border-radius: 6px;
    padding: 2px 4px;
    background-color: #ffffff;
}
QSpinBox::up-button, QSpinBox::down-button {
    width: 20px;
}
QSpinBox[objectName*=&quot;M&quot;] {
    min-width: 51px;
    max-width: 51px;
	border: 2px solid rgb(170, 170, 170);
	border-radius: 4px;
}

/* ========== 按钮样式：新增立体渐变+文字加粗，其他不变 ========== */
/* 基础按钮（浅蓝加深版+立体渐变+文字加粗） */
QPushButton {
    /* 立体渐变背景：上浅下深，增强凸起感 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #e6f2ff, stop:0.5 #dceeff, stop:1 #d0e5ff);
    color: #1e88e5; /* 文字蓝加深 */
    font-weight: bold; /* 核心：文字加粗 */
    border: 1px solid;
    border-color: #b9d9fb #9fc8f7 #9fc8f7 #b9d9fb; /* 立体边框 */
    border-radius: 6px;
    padding: 6px 16px; /* 上下内边距减少，降低高度 */
    min-height: 28px; /* 按钮高度从32→28px */
    min-width: 80px;
    font-size: 9pt;
}

/* 悬停状态：渐变加深+文字加粗保留 */
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #d7e9ff, stop:0.5 #cbe4ff, stop:1 #bddcff);
    border-color: #9fc8f7 #80b7f5 #80b7f5 #9fc8f7;
}

/* 按下状态：反向渐变+文字加粗保留 */
QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #b8d8ff, stop:0.5 #c1ddff, stop:1 #cbe4ff);
    border-color: #80b7f5 #9fc8f7 #9fc8f7 #80b7f5;
}

/* 禁用状态：无渐变+文字加粗保留 */
QPushButton:disabled {
    background: #f8f9fa;
    color: #ced4da;
    font-weight: bold;
    border-color: #e9ecef;
}

/* ========== 高亮按钮（保存类：浅绿渐变+文字加粗） ========== */
QPushButton[objectName*=&quot;save&quot;], 
QPushButton[objectName*=&quot;openORclose&quot;], 
QPushButton[objectName*=&quot;confirm&quot;],
QPushButton[objectName*=&quot;ok&quot;] {
    /* 浅绿立体渐变 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #f0fae8, stop:0.5 #e6f7e0, stop:1 #dcf4d2);
    color: #389e0d; /* 文字绿加深 */
    font-weight: bold; /* 文字加粗 */
    border-color: #c5e8b7 #a3d98b #a3d98b #c5e8b7;
}
QPushButton[objectName*=&quot;save&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #e7f5d9, stop:0.5 #d7f0cb, stop:1 #c8e7bc);
    border-color: #a3d98b #82c91e #82c91e #a3d98b;
}
QPushButton[objectName*=&quot;save&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #c8e7bc, stop:0.5 #d0e9c4, stop:1 #d7f0cb);
    border-color: #82c91e #a3d98b #a3d98b #82c91e;
}

/* ========== 危险按钮（重置/复原类：浅红渐变+文字加粗） ========== */
QPushButton[objectName*=&quot;reset&quot;], 
QPushButton[objectName*=&quot;delete&quot;],
QPushButton[objectName*=&quot;clear&quot;],
QPushButton[objectName*=&quot;复原&quot;] {
    /* 浅红立体渐变 */
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #fff0ee, stop:0.5 #ffe8e6, stop:1 #ffdedb);
    color: #cf1322; /* 文字红加深 */
    font-weight: bold; /* 文字加粗 */
    border-color: #ffccc7 #ff9a9e #ff9a9e #ffccc7;
}
QPushButton[objectName*=&quot;reset&quot;]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #ffe9e6, stop:0.5 #ffd9d6, stop:1 #ffc9c6);
    border-color: #ff9a9e #ff4d4f #ff4d4f #ff9a9e;
}
QPushButton[objectName*=&quot;reset&quot;]:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, 
                                stop:0 #ffc9c6, stop:0.5 #ffd0cd, stop:1 #ffd9d6);
    border-color: #ff4d4f #ff9a9e #ff9a9e #ff4d4f;
}</string>
