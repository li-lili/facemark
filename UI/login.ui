  <property name="styleSheet">
   <string notr="true">/* 主窗口：修复background-size报错 + 消除顶部突兀 */
QWidget#Form {
	background-image: url(:/img/cover.png);
	background-repeat: no-repeat;	
	background-position: center center;
	background-attachment: fixed;
    font-family: &quot;Microsoft YaHei&quot;, &quot;微软雅黑&quot;, sans-serif;
    font-size: 15px;
    margin: 0px;
    padding: 0px;
}

/* 文本框/下拉框：调大字体 + 保持和按钮统一风格 */
QLabel, QTextEdit, QComboBox {
   background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 200, 230, 0.65),
        stop:0.25 rgb(255, 255, 255),
		stop:0.7 rgb(255, 255, 255),
        stop:1 rgba(0, 200, 230, 0.65));
    color: rgb(0, 0, 0);
    border: 2px solid rgba(0, 230, 255, 0.9);
    border-radius: 12px;
    padding: 10px 25px 15px ;
    min-width: 300px;
    font-weight: bold;
    font-size: 20px; /* 重点：从18px调到20px，字体更大更醒目 */
    outline: none;
    /* 新增：确保下拉框文字也同步变大 */
    font-family: &quot;Microsoft YaHei&quot;, &quot;微软雅黑&quot;, sans-serif;
}

/* 核心按钮：保留原有样式 */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 230, 255, 0.7),
        stop:0.5 rgba(0, 200, 230, 0.65),
        stop:1 rgba(0, 170, 200, 0.6));
    color: #FFFFFF;
    border: 2px solid rgba(0, 230, 255, 0.9);
    border-radius: 12px;
    padding: 20px 30px;
    min-width: 300px;
    font-weight: bold;
    font-size: 18px;
    outline: none;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 255, 255, 0.8),
        stop:0.5 rgba(0, 220, 240, 0.75),
        stop:1 rgba(0, 190, 220, 0.7));
    border: 2px solid rgba(0, 255, 255, 1);
    color: #FFFFFF;
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 180, 210, 0.6),
        stop:0.5 rgba(0, 160, 190, 0.55),
        stop:1 rgba(0, 140, 170, 0.5));
    border: 2px solid rgba(0, 200, 230, 0.8);
    padding-top: 22px;
    padding-bottom: 18px;
}

QPushButton:focus {
    border: 3px solid rgba(0, 255, 255, 1);
    outline: none;
}

QPushButton:disabled {
    background: rgba(200, 200, 200, 0.5);
    border-color: rgba(150, 150, 150, 0.6);
    color: rgba(100, 100, 100, 0.7);
}</string>
